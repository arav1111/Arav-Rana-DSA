
public class Main {

    static void preorder(int[] arr, int i) {
        if (i >= arr.length) {
            return;
        }

        System.out.print(arr[i] + " "); // Root
        preorder(arr, 2 * i + 1);       // Left
        preorder(arr, 2 * i + 2);       // Right
    }

    public static void main(String[] args) {
        int[] arr = {1, 2, 3, 4, 5, 6, 7};

        preorder(arr, 0);
    }
}
