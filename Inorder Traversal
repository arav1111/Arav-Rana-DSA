public class Main {

    static void inorder(int[] arr, int i) {
        if (i >= arr.length) {
            return;
        }

        inorder(arr, 2 * i + 1);  // Left
        System.out.print(arr[i] + " "); // Root
        inorder(arr, 2 * i + 2);  // Right
    }

    public static void main(String[] args) {
        int[] arr = {1, 2, 3, 4, 5, 6, 7};

        inorder(arr, 0);
    }
}
